/*
  architecture.dot — portage-ng top-level architecture and data flow

  Deliberately kept at module-group granularity: one node per subsystem,
  primary data flow only.  Detail lives in the dedicated diagrams:
    - resolving_dispatch.dot         resolving:rule/2 dispatch
    - resolving_assumptions_flow.dot assumption/reprove flow
    - Handbook/Diagrams/08-*.dot     prover internals
    - Handbook/Diagrams/09-*.dot     reprove loop, learned constraints
    - Handbook/Diagrams/12-*.dot     ordering pass

  Generate SVG:  dot -Tsvg architecture.dot -o architecture.svg
*/

digraph portage_ng_architecture {
  rankdir=TD;
  labelloc="t";
  label="portage-ng: system architecture and data flow";
  fontsize=16;
  fontname="Helvetica";
  compound=true;
  splines=spline;
  nodesep=0.4;
  ranksep=0.55;
  node [fontname="Helvetica", fontsize=10, style=filled, margin="0.16,0.09"];
  edge [fontname="Helvetica", fontsize=9, arrowsize=0.7, color="#555555"];

  // ── Inputs ─────────────────────────────────────────────────────────

  subgraph cluster_inputs {
    label="External inputs";
    style=dashed;
    color="#aaaaaa";
    fontcolor="#666666";

    portage_tree [shape=folder, fillcolor="#f8f8f8",
                  label="Portage tree\nmd5-cache + Manifests"];
    vdb_tree     [shape=folder, fillcolor="#f8f8f8",
                  label="VDB\n/var/db/pkg"];
    conf_dirs    [shape=folder, fillcolor="#f8f8f8",
                  label="Profiles + /etc/portage\nmake.conf, package.*"];
    world_file   [shape=folder, fillcolor="#f8f8f8",
                  label="World file\n+ package sets"];
    user_target  [shape=note, fillcolor="#fff3cd",
                  label="User target\nsys-apps/portage"];

    { rank=same; portage_tree; vdb_tree; conf_dirs; world_file; user_target; }
  }

  // ── Ingestion & sync ───────────────────────────────────────────────

  subgraph cluster_ingest {
    label="Ingestion & sync  [Pipeline/ + Knowledge/ + Domain/Gentoo/]";
    color="#4477aa";
    fontcolor="#4477aa";
    style=rounded;

    repository [fillcolor="#ddeeff", shape=box,
                label="repository.pl / knowledgebase.pl\nsync, load, save (kb.qlf)\n(OO instances via context.pl)"];
    reader     [fillcolor="#ddeeff", shape=box,
                label="reader.pl / parser.pl\nread md5-cache lines"];
    eapi       [fillcolor="#ddeeff", shape=box,
                label="eapi.pl\nDCG grammar (PMS 9):\ndeps, USE, slots, versions"];
  }

  // ── Knowledge base ─────────────────────────────────────────────────

  subgraph cluster_kb {
    label="Knowledge base  [Knowledge/ + Domain/Gentoo/]";
    color="#44aa77";
    fontcolor="#44aa77";
    style=rounded;

    cache      [fillcolor="#ddf5dd", shape=cylinder,
                label="cache.pl\nentry/5 · ordered_entry/5\nentry_metadata/4 · manifest/5"];
    vdb        [fillcolor="#ddf5dd", shape=box,
                label="vdb.pl\ninstalled packages (pkg://)"];
    preference [fillcolor="#c8eac8", shape=box,
                label="profile.pl · userconfig.pl\n→ preference.pl\nUSE, keywords, masks"];
    set_mod    [fillcolor="#c8eac8", shape=box,
                label="set.pl\nworld + package sets"];
    query      [fillcolor="#c8eac8", shape=box,
                label="query.pl\ngoal-expanded KB queries"];

    { rank=same; cache; vdb; preference; set_mod; }
  }

  // ── Front-ends ─────────────────────────────────────────────────────

  subgraph cluster_frontends {
    label="Front-ends  [Application/ + Test/]";
    style=dashed;
    color="#aaaaaa";
    fontcolor="#666666";

    interface [fillcolor="#eeeeee", shape=box, style="filled,bold",
               label="interface.pl + Interface/  [Application/]\nCLI: modes, options, exit codes 0/1/2"];
    distributed [fillcolor="#dde8f0", shape=box,
                 label="server.pl · client.pl · cluster.pl\n[Application/Mode/]  distributed proving"];
    test [fillcolor="#e0f0e0", shape=box,
          label="test.pl · unittest.pl  [Test/]\n534 PLUnit tests + 80 overlay cases"];

    { rank=same; interface; distributed; test; }
  }

  // ── Proving pipeline ───────────────────────────────────────────────

  subgraph cluster_pipeline {
    label="Proving pipeline  [Pipeline/]";
    color="#338866";
    fontcolor="#338866";
    style=rounded;

    pipeline [fillcolor="#e8f5e8", shape=box, style="filled,bold", ordering=out,
              label="pipeline.pl\n5-tier fallback (strict → keyword\n→ blockers → unmask → both)"];
    resolver [fillcolor="#ddffee", shape=box,
              label="resolver.pl  (pass 1: what)\nresolver:resolve/9"];
    orderer  [fillcolor="#ddffee", shape=box,
              label="orderer.pl  (pass 2: when)\norderer:order/4\nwave projection + preferences"];
    prover   [fillcolor="#ffeedd", shape=box, style="filled,bold", ordering=out,
              label="prover.pl — generic engine\nprover:prove(Rules, ...)\nProof · Model · Constraints · Triggers\nreprove + learned constraints"];
  }

  // ── Rule sets ──────────────────────────────────────────────────────

  subgraph cluster_rules {
    label="Rule sets  [Domain/Gentoo/Rules/]  —  consult the KB via query.pl";
    color="#8855aa";
    fontcolor="#8855aa";
    style=rounded;

    resolving [fillcolor="#eeddff", shape=box,
               label="resolving.pl + Resolving/\npass-1 domain rules:\ncandidates, USE, deps,\nblockers, assumptions"];
    ordering  [fillcolor="#eeddff", shape=box,
               label="ordering.pl\npass-2 planning laws\n+ step/requires/prefers/world"];
    unmerging [fillcolor="#eeddff", shape=box,
               label="unmerging.pl\nsame laws, removal bindings\n(depclean uninstall order)"];
  }

  // ── Output ─────────────────────────────────────────────────────────

  subgraph cluster_output {
    label="Output  [Pipeline/Printer/ + Application/Output/]";
    color="#555555";
    fontcolor="#555555";
    style=rounded;

    printer   [fillcolor="#eeeeee", shape=box,
               label="printer.pl + Printer/\nplan, assumptions,\nsuggestions, warnings"];
    grapher   [fillcolor="#eeeeee", shape=box,
               label="grapher.pl / writer.pl\n--graph, .merge files"];
    terminal  [shape=note, fillcolor="#f8f8f8",
               label="Terminal output\n/ graph directory"];

    { rank=same; printer; grapher; }
  }

  llm [fillcolor="#dde8f0", shape=box,
       label="llm.pl + Llm/  [Application/]\nexplain plans & errors,\nsemantic search"];

  // ── Execution ──────────────────────────────────────────────────────

  subgraph cluster_exec {
    label="Execution  [Pipeline/ + Domain/Gentoo/]";
    color="#996633";
    fontcolor="#996633";
    style=rounded;

    builder  [fillcolor="#f5e6d0", shape=box,
              label="builder.pl + Builder/\nebuild phases, downloads,\njobserver, binpkg"];
    depclean [fillcolor="#f5e6d0", shape=box,
              label="depclean.pl\nproof-based removal\n(prover: resolving closure\n+ unmerging order)"];

    { rank=same; builder; depclean; }
  }

  // ── Data flow ──────────────────────────────────────────────────────

  // inputs → ingestion / kb
  portage_tree -> repository [label="sync"];
  vdb_tree     -> vdb;
  conf_dirs    -> preference;
  world_file   -> set_mod;
  user_target  -> interface;

  // ingestion → kb
  repository -> reader [label="triggers read"];
  reader     -> eapi   [label="lines"];
  eapi       -> cache  [label="assert facts"];
  repository -> cache  [label="kb.qlf"];
  vdb        -> cache  [label="pkg:// entries"];

  // kb → queries
  cache      -> query;
  preference -> query;

  // front-ends → pipeline
  set_mod     -> interface [style=dashed, label="@world"];
  interface   -> pipeline  [label="prove_plan_with_fallback"];
  distributed -> pipeline  [style=dashed, label="remote proofs"];
  test        -> pipeline  [style=dashed, label="regression"];

  // the two proving passes share one engine
  pipeline -> resolver [label="1"];
  pipeline -> orderer  [label="2"];
  resolver -> orderer  [label="Proof + Triggers"];
  resolver -> prover [label="prove(resolving, ...)"];
  orderer  -> prover [label="prove_once(ordering, ...)"];
  prover   -> resolving [label="Rules:rule/2", style=dashed];
  prover   -> ordering  [style=dashed];
  prover   -> unmerging [style=dashed];

  // results → output / execution
  orderer -> printer [label="plan + proof"];
  orderer -> builder [style=dashed, label="--merge:\nexecute plan"];
  printer -> terminal;
  interface -> grapher  [style=dashed, label="--graph"];
  interface -> depclean [style=dashed, label="--depclean"];
  grapher -> terminal [label=".merge"];
  printer -> llm [dir=back, style=dashed, label="explain"];

}
