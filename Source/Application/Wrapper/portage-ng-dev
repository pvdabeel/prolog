#!/bin/sh
#
# Minimal launcher for portage-ng in standalone mode, without relying on a shell alias.
# Useful for CI and for running inside restricted shells (e.g. Cursor sandbox).
#
# Usage:
#   ./Source/Application/Wrapper/portage-ng-dev --mode standalone accerciser
#   ./Source/Application/Wrapper/portage-ng-dev --mode standalone --shell
#
set -eu

# Live ebuilds clone via HTTPS. A bad/truncated GitLab path returns 401 and
# git would otherwise block on "Username for 'https://...'".
export GIT_TERMINAL_PROMPT=0
export GIT_ASKPASS=/bin/false
export GIT_CONFIG_COUNT=2
export GIT_CONFIG_KEY_0=credential.helper
export GIT_CONFIG_VALUE_0=
export GIT_CONFIG_KEY_1=credential.interactive
export GIT_CONFIG_VALUE_1=never

# This script lives under Source/Application/Wrapper/, so the project root is three levels up.
WRAPPER_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT_DIR="$(CDPATH= cd -- "$WRAPPER_DIR/../../.." && pwd)"
IPCLIENT_PL="$ROOT_DIR/Source/Application/Client/ipclient.pl"

# -----------------------------------------------------------------------------
# Ultra-early --mode ipc fast-path
# -----------------------------------------------------------------------------
#
# Jump straight into ipclient.pl before the timeout/arg-rewrite loops when the
# invocation is a plain ipc client request. Skip when legacy/profile/choice-log
# or a hard timeout is requested (those need the slower path below).
_early_ipc=1
_early_mode=""
_prev=""
for a in "$@"; do
  case "$a" in
    -h|--help|-V|--version|help|--profile|--choice-log|--timeout|--hard-time-limit)
      _early_ipc=0
      ;;
    --timeout=*|--hard-time-limit=*)
      _early_ipc=0
      ;;
  esac
  if [ "$_prev" = "--mode" ] && [ -z "$_early_mode" ]; then
    _early_mode="$a"
  fi
  case "$a" in
    --mode=*)
      [ -z "$_early_mode" ] && _early_mode="${a#*=}"
      ;;
  esac
  _prev="$a"
done
if [ "$_early_ipc" = "1" ] \
   && [ "$_early_mode" = "ipc" ] \
   && [ "${PORTAGE_NG_IPC_LEGACY:-0}" != "1" ] \
   && [ -f "$IPCLIENT_PL" ]; then
  export PORTAGE_NG_ROOT="$ROOT_DIR"
  export PORTAGE_NG_DEV="$WRAPPER_DIR/portage-ng-dev"
  exec swipl -q -f "$IPCLIENT_PL" -g ipclient:main -t halt -- "$@"
fi


# -----------------------------------------------------------------------------
# Fast-path: --help / -h
# -----------------------------------------------------------------------------
#
# `portage-ng.pl`'s `main/0` initializes the knowledgebase and preferences, which
# can fail in partial environments (e.g. when running with restricted FS perms).
# For a help request we should not boot Prolog at all.
#
for a in "$@"; do
  case "$a" in
    -h|--help|help)
      cat <<'EOF'
portage-ng-dev

Usage:
  portage-ng-dev [--timeout SECONDS] [--mode standalone] <target>
  portage-ng-dev --mode standalone --shell

Notes:
  - --timeout enforces a hard wall-clock timeout (kills process group).
  - --profile enables compile-time instrumentation (sampler counters,
    debug hooks, timeout traces). Without it, these are compiled out
    for zero overhead.
  - --choice-log enables compile-time choice-event logging (-Dchoice_log)
    and arms the runtime buffer. Without it, emit/wrap sites are
    compiled out for zero overhead.
  - This wrapper passes all other args to portage-ng's Prolog main/0.
EOF
      exit 0
      ;;
    -V|--version)
      # Collect all entries into a temp file (tab-separated: name, version, path)
      _ver_tmp=$(mktemp)
      trap 'rm -f "$_ver_tmp"' EXIT

      # portage-ng itself
      ng_ver="$(git -C "$ROOT_DIR" --no-pager log -1 --date=format:%Y.%m.%d --pretty="%cd (%h)" 2>/dev/null || echo "unknown")"
      printf '%s\t%s\t%s\n' "portage-ng" "$ng_ver" "$ROOT_DIR" >> "$_ver_tmp"

      # Determine hostname-specific config file.
      if command -v swipl >/dev/null 2>&1; then
        hostname="$(swipl -g 'socket:gethostname(H), write(H), halt.' 2>/dev/null || echo "")"
      fi
      if [ -z "$hostname" ]; then
        hostname="$(hostname 2>/dev/null | tr '[:upper:]' '[:lower:]' || echo "default")"
      fi
      config_file="$ROOT_DIR/Source/Config/${hostname}.pl"
      if [ ! -f "$config_file" ]; then
        config_file="$ROOT_DIR/Source/Config/default.pl"
      fi

      # Extract registered repositories from the config.
      grep -E '^:-\s+\w+:init\(' "$config_file" 2>/dev/null | while IFS= read -r line; do
        repo_name="$(echo "$line" | sed "s/^:-[[:space:]]*\([a-zA-Z_][a-zA-Z0-9_]*\):init(.*/\1/")"
        repo_path="$(echo "$line" | sed "s/.*:init('//" | sed "s/'.*//")"
        if [ -d "$repo_path/.git" ] || git -C "$repo_path" rev-parse --git-dir >/dev/null 2>&1; then
          repo_ver="$(git -C "$repo_path" --no-pager log -1 --date=format:%Y.%m.%d --pretty="%cd (%h)" 2>/dev/null || echo "unknown")"
        else
          repo_ver="(not a git repo)"
        fi
        printf '%s\t%s\t%s\n' "$repo_name" "$repo_ver" "$repo_path" >> "$_ver_tmp"
      done

      # Compute column widths, then print aligned output
      _col1=0; _col2=0
      while IFS="$(printf '\t')" read -r _n _v _p; do
        _len1=${#_n}; _len2=${#_v}
        [ "$_len1" -gt "$_col1" ] && _col1=$_len1
        [ "$_len2" -gt "$_col2" ] && _col2=$_len2
      done < "$_ver_tmp"

      while IFS="$(printf '\t')" read -r _n _v _p; do
        printf "%-${_col1}s  %-${_col2}s  %s\n" "$_n" "$_v" "$_p"
      done < "$_ver_tmp"

      rm -f "$_ver_tmp"
      exit 0
      ;;
  esac
done

# -----------------------------------------------------------------------------
# Hard wall-clock timeout wrapper
# -----------------------------------------------------------------------------
#
# Prolog-side time limits are best-effort: some code paths can keep the process
# alive past the intended limit. For CI and automation, we also enforce a hard
# wall-clock timeout at the process level based on `--timeout`.
#
# This kills the whole process group (TERM, then KILL) so spawned children don't
# linger.
HARD_LIMIT=""
INSTRUMENTATION=""
CHOICE_LOG=""
prev=""
NEW_ARGS=""
for a in "$@"; do
  if [ "$prev" = "--timeout" ]; then
    HARD_LIMIT="$a"
    NEW_ARGS="$NEW_ARGS$(printf '\n%s' "$a")"
    prev=""
    continue
  fi
  if [ "$prev" = "--hard-time-limit" ]; then
    HARD_LIMIT="$a"
    prev=""
    continue
  fi
  case "$a" in
    --time-limit|--time-limit=*)
      echo "Warning: --time-limit is not a valid option. Did you mean --timeout?" >&2
      exit 1
      ;;
    --timeout)
      prev="--timeout"
      NEW_ARGS="$NEW_ARGS$(printf '\n%s' "$a")"
      ;;
    --timeout=*)
      HARD_LIMIT="${a#*=}"
      NEW_ARGS="$NEW_ARGS$(printf '\n%s' "$a")"
      ;;
    --hard-time-limit)
      prev="--hard-time-limit"
      ;;
    --hard-time-limit=*)
      HARD_LIMIT="${a#*=}"
      ;;
    --profile)
      INSTRUMENTATION=true
      ;;
    --choice-log)
      CHOICE_LOG=true
      NEW_ARGS="$NEW_ARGS$(printf '\n%s' "$a")"
      ;;
    *)
      NEW_ARGS="$NEW_ARGS$(printf '\n%s' "$a")"
      ;;
  esac
done

# Rebuild positional parameters (strip wrapper-only flags, preserve spaces).
IFS='
'
set -- $NEW_ARGS
unset IFS

is_pos_int() {
  case "${1:-}" in
    ''|*[!0-9]*)
      return 1
      ;;
    *)
      [ "$1" -gt 0 ] 2>/dev/null
      ;;
  esac
}

EXTRA_FLAGS=""
if [ "$INSTRUMENTATION" = "true" ]; then
  EXTRA_FLAGS="-Dinstrumentation=true"
fi
if [ "$CHOICE_LOG" = "true" ]; then
  EXTRA_FLAGS="$EXTRA_FLAGS -Dchoice_log=true"
fi

# -----------------------------------------------------------------------------
# Detect --mode (first occurrence)
# -----------------------------------------------------------------------------
MODE=""
_prev=""
for a in "$@"; do
  if [ "$_prev" = "--mode" ]; then
    MODE="$a"
    break
  fi
  case "$a" in
    --mode=*)
      MODE="${a#*=}"
      break
      ;;
  esac
  _prev="$a"
done

# -----------------------------------------------------------------------------
# Hard wall-clock timeout helper (Python watchdog)
# -----------------------------------------------------------------------------
run_with_timeout() {
  # Usage: run_with_timeout LIMIT cmd args...
  limit="$1"
  shift
  PYTHON=""
  if command -v python3 >/dev/null 2>&1; then
    PYTHON="python3"
  elif command -v python >/dev/null 2>&1; then
    PYTHON="python"
  fi
  if [ -z "$PYTHON" ]; then
    exec "$@"
  fi
  exec "$PYTHON" -c '
import os, signal, subprocess, sys, time

def killpg(pid, sig):
    try:
        os.killpg(pid, sig)
    except Exception:
        try:
            os.kill(pid, sig)
        except Exception:
            pass

limit = int(sys.argv[1])
cmd = sys.argv[2:]

p = subprocess.Popen(
    cmd,
    stdin=sys.stdin,
    stdout=sys.stdout,
    stderr=sys.stderr,
    start_new_session=True,
)

deadline = time.time() + limit
while True:
    rc = p.poll()
    if rc is not None:
        sys.exit(rc)
    if time.time() >= deadline:
        break
    time.sleep(0.1)

killpg(p.pid, signal.SIGTERM)
time.sleep(2.0)
killpg(p.pid, signal.SIGKILL)
rc = p.wait()
sys.exit(rc if rc is not None else 124)
' "$limit" "$@"
}

# -----------------------------------------------------------------------------
# Fast-path: --mode ipc → ultralight ipclient.pl (no common modules / world)
#
# Escape hatch: PORTAGE_NG_IPC_LEGACY=1 keeps the old portage-ng.pl ipc path
# for A/B comparison. Instrumentation/choice-log also force the legacy path.
# -----------------------------------------------------------------------------
if [ "$MODE" = "ipc" ] \
   && [ "${PORTAGE_NG_IPC_LEGACY:-0}" != "1" ] \
   && [ -z "$INSTRUMENTATION" ] \
   && [ -z "$CHOICE_LOG" ] \
   && [ -f "$IPCLIENT_PL" ]; then
  export PORTAGE_NG_ROOT="$ROOT_DIR"
  export PORTAGE_NG_DEV="$WRAPPER_DIR/portage-ng-dev"
  # Quiet, no -O, no huge stacks: startup dominates for this tiny client.
  if is_pos_int "$HARD_LIMIT"; then
    run_with_timeout "$HARD_LIMIT" \
      swipl -q -f "$IPCLIENT_PL" -g ipclient:main -t halt -- "$@"
  fi
  exec swipl -q -f "$IPCLIENT_PL" -g ipclient:main -t halt -- "$@"
fi

if is_pos_int "$HARD_LIMIT"; then
  # Use a Python watchdog so we can keep swipl in the foreground (preserves
  # heredoc/pipe input for `--shell`) while still enforcing a hard wall-clock cap.
  run_with_timeout "$HARD_LIMIT" \
    swipl -O \
      --stack-limit=256G --table-space=256G --shared-table-space=256G \
      -f "$ROOT_DIR/portage-ng.pl" \
      -p "portage=$ROOT_DIR" \
      -Dverbose_autoload=false \
      $EXTRA_FLAGS \
      -g main -- "$@"
fi

# No hard time limit -> behave like a normal launcher.
exec swipl -O \
  --stack-limit=32G \
  -f "$ROOT_DIR/portage-ng.pl" \
  -p "portage=$ROOT_DIR" \
  -Dverbose_autoload=false \
  $EXTRA_FLAGS \
  -g main -- "$@"

